FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 0.0001;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           nonuniform List<scalar> 0();
    }
    outlet
    {
        type            zeroGradient;
    }
    chip_bases
    {
        type            epsilonLowReWallFunction;
        value           nonuniform List<scalar> 0();
    }
    walls
    {
        type            epsilonLowReWallFunction;
        value           uniform 0.0001;
    }
    procBoundary7to0
    {
        type            processor;
        value           uniform 0.0001;
    }
    procBoundary7to2
    {
        type            processor;
        value           uniform 0.0001;
    }
    procBoundary7to5
    {
        type            processor;
        value           uniform 0.0001;
    }
    procBoundary7to6
    {
        type            processor;
        value           uniform 0.0001;
    }
    procBoundary7to8
    {
        type            processor;
        value           uniform 0.0001;
    }
    procBoundary7to11
    {
        type            processor;
        value           uniform 0.0001;
    }
}


