FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 298.15;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 298.15;
    }
    outlet
    {
        type            zeroGradient;
    }
    chip_bases
    {
        type            externalWallHeatFluxTemperature;
        mode            flux;
        q               uniform 125000;
        kappaMethod     fluidThermo;
        value           nonuniform List<scalar> 0();
    }
    walls
    {
        type            zeroGradient;
    }
    procBoundary14to8
    {
        type            processor;
        value           uniform 298.15;
    }
    procBoundary14to11
    {
        type            processor;
        value           uniform 298.15;
    }
    procBoundary14to12
    {
        type            processor;
        value           uniform 298.15;
    }
    procBoundary14to13
    {
        type            processor;
        value           uniform 298.15;
    }
    procBoundary14to15
    {
        type            processor;
        value           uniform 298.15;
    }
}


