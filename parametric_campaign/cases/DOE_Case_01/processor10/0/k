    {
        type            fixedValue;
        value           nonuniform List<scalar> 0();
    }
    outlet
    {
        type            zeroGradient;
    }
    chip_bases
    {
        type            kLowReWallFunction;
        value           uniform 1e-05;
    }
    walls
    {
        type            kLowReWallFunction;
        value           uniform 1e-05;
    }
    procBoundary10to4
    {
        type            processor;
        value           uniform 1e-05;
    }
    procBoundary10to5
    {
        type            processor;
        value           uniform 1e-05;
    }
    procBoundary10to6
    {
        type            processor;
        value           uniform 1e-05;
    }
    procBoundary10to9
    {
        type            processor;
        value           uniform 1e-05;
    }
    procBoundary10to11
    {
        type            processor;
        value           uniform 1e-05;
    }
    procBoundary10to12
    {
        type            processor;
        value           uniform 1e-05;
    }
    procBoundary10to13
    {
        type            processor;
        value           uniform 1e-05;
    }
}


